{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anx.dev/schemas/anx.agent-model-response.v1.schema.json",
  "title": "ANX Agent Model Response",
  "description": "Compact provider-facing response contract. ANX deterministically attaches the mandatory machine-readable evidence envelope after model generation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "documentId",
    "task",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "anx.agent-model-response.v1"
    },
    "documentId": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "$ref": "#/$defs/task"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "answer",
        "citations",
        "evidenceJudgment"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceJudgment": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
