{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andoc.dev/schemas/andoc.document.v1.schema.json",
  "title": "ANDoc canonical document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "documentId",
    "revision",
    "title",
    "locale",
    "createdAt",
    "updatedAt",
    "metadata",
    "assets",
    "blocks"
  ],
  "properties": {
    "schema": { "const": "andoc.document.v1" },
    "documentId": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "minLength": 2 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "assets": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/asset" }
    },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "textRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "marks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["bold", "italic", "underline", "strike", "code", "subscript", "superscript"]
          }
        },
        "href": { "type": "string", "format": "uri-reference" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["imported", "human", "agent", "generated"] },
        "sourceId": { "type": "string" },
        "sourceUri": { "type": "string", "format": "uri-reference" },
        "page": { "type": "integer", "minimum": 1 },
        "bbox": {
          "type": "array",
          "prefixItems": [
            { "type": "number" },
            { "type": "number" },
            { "type": "number" },
            { "type": "number" }
          ],
          "items": false
        },
        "capturedAt": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "baseBlock": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "attrs": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "paragraph": {
      "allOf": [
        { "$ref": "#/$defs/baseBlock" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "content"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "type": { "const": "paragraph" },
            "content": { "type": "array", "items": { "$ref": "#/$defs/textRun" } },
            "provenance": { "$ref": "#/$defs/provenance" },
            "attrs": { "type": "object", "additionalProperties": true }
          }
        }
      ]
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "level", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "heading" },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "content": { "type": "array", "items": { "$ref": "#/$defs/textRun" } },
        "provenance": { "$ref": "#/$defs/provenance" },
        "attrs": { "type": "object", "additionalProperties": true }
      }
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "content": { "type": "array", "items": { "$ref": "#/$defs/textRun" } },
        "children": { "type": "array", "items": { "$ref": "#/$defs/listItem" } },
        "provenance": { "$ref": "#/$defs/provenance" },
        "attrs": { "type": "object", "additionalProperties": true }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "ordered", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "list" },
        "ordered": { "type": "boolean" },
        "start": { "type": "integer", "minimum": 1 },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/listItem" } },
        "provenance": { "$ref": "#/$defs/provenance" },
        "attrs": { "type": "object", "additionalProperties": true }
      }
    },
    "footnote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "footnote" },
        "label": { "type": "string", "minLength": 1 },
        "content": { "type": "array", "items": { "$ref": "#/$defs/textRun" } },
        "noteKind": { "enum": ["footnote", "endnote"] },
        "anchorIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "anchorStatus": { "enum": ["resolved", "uncertain", "unanchored"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "attrs": { "type": "object", "additionalProperties": true }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "extensionId", "version", "payload", "fallback"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "extension" },
        "extensionId": { "type": "string", "pattern": "^andoc\\.extension\\.[a-z0-9][a-z0-9.-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "payload": { "type": "object", "additionalProperties": true },
        "fallback": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/textRun" } },
        "provenance": { "$ref": "#/$defs/provenance" },
        "attrs": { "type": "object", "additionalProperties": true }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "assetId", "alt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "image" },
        "assetId": { "$ref": "#/$defs/id" },
        "alt": { "type": "string", "minLength": 1 },
        "caption": { "type": "array", "items": { "$ref": "#/$defs/textRun" } },
        "provenance": { "$ref": "#/$defs/provenance" },
        "attrs": { "type": "object", "additionalProperties": true }
      }
    },
    "tableCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "content": { "type": "array", "items": { "$ref": "#/$defs/textRun" } },
        "header": { "type": "boolean" },
        "colspan": { "type": "integer", "minimum": 1 },
        "rowspan": { "type": "integer", "minimum": 1 },
        "provenance": { "$ref": "#/$defs/provenance" },
        "attrs": { "type": "object", "additionalProperties": true }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "rows"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "table" },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/tableCell" }
          }
        },
        "caption": { "type": "array", "items": { "$ref": "#/$defs/textRun" } },
        "provenance": { "$ref": "#/$defs/provenance" },
        "attrs": { "type": "object", "additionalProperties": true }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "alt", "spec"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "chart" },
        "alt": { "type": "string", "minLength": 1 },
        "spec": { "type": "object", "additionalProperties": true },
        "dataAssetId": { "$ref": "#/$defs/id" },
        "fallbackAssetId": { "$ref": "#/$defs/id" },
        "caption": { "type": "array", "items": { "$ref": "#/$defs/textRun" } },
        "provenance": { "$ref": "#/$defs/provenance" },
        "attrs": { "type": "object", "additionalProperties": true }
      }
    },
    "pageBreak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "pageBreak" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "attrs": { "type": "object", "additionalProperties": true }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/list" },
        { "$ref": "#/$defs/footnote" },
        { "$ref": "#/$defs/extension" },
        { "$ref": "#/$defs/image" },
        { "$ref": "#/$defs/table" },
        { "$ref": "#/$defs/chart" },
        { "$ref": "#/$defs/pageBreak" }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "packagePath", "mediaType", "sha256", "size"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "packagePath": { "type": "string", "pattern": "^assets/[A-Za-z0-9._/-]+$" },
        "mediaType": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "originalName": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
