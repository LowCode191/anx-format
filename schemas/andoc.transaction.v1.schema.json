{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andoc.dev/schemas/andoc.transaction.v1.schema.json",
  "title": "ANDoc canonical transaction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "baseRevision", "actor", "timestamp", "operations"],
  "properties": {
    "schema": { "const": "andoc.transaction.v1" },
    "id": { "type": "string", "minLength": 1 },
    "baseRevision": { "type": "integer", "minimum": 0 },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["human", "agent", "import", "system"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "message": { "type": "string" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "asset"],
            "properties": {
              "op": { "const": "addAsset" },
              "asset": { "$ref": "#/$defs/asset" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "targetId", "afterId"],
            "properties": {
              "op": { "const": "moveBlock" },
              "targetId": { "type": "string", "minLength": 1 },
              "afterId": { "type": ["string", "null"] }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "afterId", "blocks"],
            "properties": {
              "op": { "const": "insertBlocks" },
              "afterId": { "type": ["string", "null"] },
              "blocks": { "type": "array", "minItems": 1, "items": { "type": "object" } }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "targetId", "content"],
            "properties": {
              "op": { "const": "updateTextBlock" },
              "targetId": { "type": "string", "minLength": 1 },
              "content": { "type": "array", "items": { "$ref": "#/$defs/textRun" } },
              "level": { "type": "integer", "minimum": 1, "maximum": 6 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "targetId", "block"],
            "properties": {
              "op": { "const": "replaceBlock" },
              "targetId": { "type": "string" },
              "block": { "type": "object" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "targetId", "expectedCurrentText", "content", "candidate", "reason"],
            "properties": {
              "op": { "const": "applyTextCandidate" },
              "targetId": { "type": "string", "minLength": 1 },
              "expectedCurrentText": { "type": "string" },
              "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/textRun" } },
              "reason": { "type": "string", "minLength": 1 },
              "candidate": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "candidateSha256", "engine", "engineVersion", "page"],
                "properties": {
                  "kind": { "enum": ["ocr", "agent-vision"] },
                  "candidateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "engine": { "type": "string", "minLength": 1 },
                  "engineVersion": { "type": "string", "minLength": 1 },
                  "page": { "type": "integer", "minimum": 1 },
                  "policyId": { "type": "string" },
                  "policySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "modelHashes": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
                  "meanConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
                  "normalizedSimilarity": { "type": "number", "minimum": 0, "maximum": 1 },
                  "recommendation": { "type": "string" }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "tableId", "afterRowIndex", "cells"],
            "properties": {
              "op": { "const": "insertTableRow" },
              "tableId": { "type": "string", "minLength": 1 },
              "afterRowIndex": { "type": ["integer", "null"], "minimum": 0 },
              "cells": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tableCell" } }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "tableId", "rowIndex"],
            "properties": {
              "op": { "const": "removeTableRow" },
              "tableId": { "type": "string", "minLength": 1 },
              "rowIndex": { "type": "integer", "minimum": 0 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "tableId", "afterColumnIndex", "cells"],
            "properties": {
              "op": { "const": "insertTableColumn" },
              "tableId": { "type": "string", "minLength": 1 },
              "afterColumnIndex": { "type": ["integer", "null"], "minimum": 0 },
              "cells": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tableCell" } }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "tableId", "columnIndex"],
            "properties": {
              "op": { "const": "removeTableColumn" },
              "tableId": { "type": "string", "minLength": 1 },
              "columnIndex": { "type": "integer", "minimum": 0 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "targetId"],
            "properties": {
              "op": { "const": "removeBlock" },
              "targetId": { "type": "string" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "tableId", "cellId", "content"],
            "properties": {
              "op": { "const": "updateTableCell" },
              "tableId": { "type": "string", "minLength": 1 },
              "cellId": { "type": "string", "minLength": 1 },
              "content": { "type": "array", "items": { "$ref": "#/$defs/textRun" } }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "targetId", "patch"],
            "properties": {
              "op": { "const": "updateMediaMetadata" },
              "targetId": { "type": "string", "minLength": 1 },
              "patch": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "alt": { "type": "string", "minLength": 1 },
                  "caption": { "type": "array", "items": { "$ref": "#/$defs/textRun" } }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "targetId", "data", "evidence"],
            "properties": {
              "op": { "const": "updateChartData" },
              "targetId": { "type": "string", "minLength": 1 },
              "data": { "$ref": "#/$defs/chartData" },
              "evidence": { "$ref": "#/$defs/chartDataEvidence" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "patch"],
            "properties": {
              "op": { "const": "setDocument" },
              "patch": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": { "type": "string", "minLength": 1 },
                  "locale": { "type": "string", "minLength": 2 },
                  "metadata": { "type": "object", "additionalProperties": true }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "metadata"],
            "properties": {
              "op": { "const": "replaceDocumentMetadata" },
              "metadata": { "type": "object", "additionalProperties": true }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "packagePath", "mediaType", "sha256", "size"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "packagePath": { "type": "string", "pattern": "^assets/[^/]+$" },
        "mediaType": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "originalName": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "textRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "marks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["bold", "italic", "underline", "strike", "code", "subscript", "superscript"]
          }
        },
        "href": { "type": "string", "format": "uri-reference" }
      }
    },
    "tableCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "content": { "type": "array", "items": { "$ref": "#/$defs/textRun" } },
        "header": { "type": "boolean" },
        "colspan": { "type": "integer", "minimum": 1 },
        "rowspan": { "type": "integer", "minimum": 1 },
        "provenance": { "type": "object", "additionalProperties": true },
        "attrs": { "type": "object", "additionalProperties": true }
      }
    },
    "chartData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": ["string", "number", "null"] }
          }
        }
      }
    },
    "chartDataEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "source", "verified"],
      "properties": {
        "method": { "enum": ["imported", "human-provided", "agent-provided", "local-extraction"] },
        "source": { "type": "string", "minLength": 1 },
        "verified": { "type": "boolean" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
