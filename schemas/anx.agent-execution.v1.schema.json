{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anx.dev/schemas/anx.agent-execution.v1.schema.json",
  "title": "ANX retained agent execution evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executionId",
    "documentId",
    "sourceRevision",
    "documentPackageSha256",
    "reviewableContentSha256",
    "provider",
    "requestedModel",
    "actualModel",
    "startedAt",
    "completedAt",
    "durationMs",
    "requestSha256",
    "responseSha256",
    "toolManifestSha256",
    "citationEvidenceSha256",
    "citationCount",
    "resolvedCitationCount",
    "safetyMode",
    "recordSha256"
  ],
  "properties": {
    "schema": { "const": "anx.agent-execution.v1" },
    "executionId": { "$ref": "#/$defs/id" },
    "documentId": { "$ref": "#/$defs/id" },
    "sourceRevision": { "type": "integer", "minimum": 0 },
    "documentPackageSha256": { "$ref": "#/$defs/sha256" },
    "reviewableContentSha256": { "$ref": "#/$defs/sha256" },
    "provider": { "type": "string", "minLength": 1 },
    "requestedModel": { "type": "string", "minLength": 1 },
    "actualModel": { "type": ["string", "null"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "requestSha256": { "$ref": "#/$defs/sha256" },
    "responseSha256": { "$ref": "#/$defs/sha256" },
    "toolManifestSha256": { "$ref": "#/$defs/sha256" },
    "citationEvidenceSha256": { "$ref": "#/$defs/sha256" },
    "citationCount": { "type": "integer", "minimum": 0 },
    "resolvedCitationCount": { "type": "integer", "minimum": 0 },
    "safetyMode": { "const": "read-only-evidence" },
    "recordSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
