{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anx.dev/schemas/anx.agent-attestation.v1.schema.json",
  "title": "ANX authenticated agent execution attestation payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "agentId",
    "provider",
    "requestedModel",
    "actualModel",
    "executionId",
    "purpose",
    "sourceRevision",
    "reviewableContentSha256",
    "finalizationId",
    "documentId",
    "revision",
    "protectedEntryRootSha256",
    "toolManifestSha256",
    "executionRecordSha256",
    "issuedAt",
    "nonce",
    "keyId",
    "publicKeySpki",
    "publicKeySha256",
    "value"
  ],
  "properties": {
    "schema": { "const": "anx.agent-attestation.v1" },
    "agentId": { "$ref": "#/$defs/id" },
    "provider": { "type": "string", "minLength": 1 },
    "requestedModel": { "type": "string", "minLength": 1 },
    "actualModel": { "type": ["string", "null"] },
    "executionId": { "$ref": "#/$defs/id" },
    "purpose": { "enum": ["prepared", "reviewed", "validated", "evidence-checked"] },
    "sourceRevision": { "type": "integer", "minimum": 0 },
    "reviewableContentSha256": { "$ref": "#/$defs/sha256" },
    "finalizationId": { "$ref": "#/$defs/id" },
    "documentId": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 0 },
    "protectedEntryRootSha256": { "$ref": "#/$defs/sha256" },
    "toolManifestSha256": { "$ref": "#/$defs/sha256" },
    "executionRecordSha256": { "$ref": "#/$defs/sha256" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "nonce": { "$ref": "#/$defs/id" },
    "keyId": { "$ref": "#/$defs/id" },
    "publicKeySpki": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
    "publicKeySha256": { "$ref": "#/$defs/sha256" },
    "value": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
